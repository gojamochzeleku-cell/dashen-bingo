import TelegramBot from 'node-telegram-bot-api';
import dotenv from 'dotenv';
import { getOrCreateUser, getUserBalance, addFunds } from './lib/database';

dotenv.config({ path: '../../.env' });

const token = process.env.TELEGRAM_BOT_TOKEN;
if (!token) {
  console.error('❌ TELEGRAM_BOT_TOKEN is missing in .env file!');
  process.exit(1);
}

const bot = new TelegramBot(token, { polling: true });

console.log('🤖 [BOT] Dashen Bingo Bot is starting...');

const userCache = new Map<number, number>();

async function ensureUser(telegramId: number, username: string, firstName: string): Promise<number> {
  if (userCache.has(telegramId)) {
    return userCache.get(telegramId)!;
  }
  const userId = await getOrCreateUser(telegramId, username, firstName);
  userCache.set(telegramId, userId);
  return userId;
}

// Helper to safely format balance
const fmt = (bal: number) => Number(bal).toFixed(2);

bot.onText(/\/start/, async (msg) => {
  const chatId = msg.chat.id;
  const telegramId = msg.from?.id || 0;
  const username = msg.from?.username || 'Unknown';
  const firstName = msg.from?.first_name || 'Player';

  const userId = await ensureUser(telegramId, username, firstName);
  const balance = await getUserBalance(userId);

  const welcomeMessage = `
🎱 *Welcome to Dashen Bingo, ${firstName}!* 

👤 *Account*
Username: @${username}
User ID: ${userId}

💰 *Balance*
Current: ${fmt(balance)} ETB
Pending: 0.00 ETB

Test your luck and win big! Use the menu below:
  `.trim();

  bot.sendMessage(chatId, welcomeMessage, {
    parse_mode: 'Markdown',
    reply_markup: {
      inline_keyboard: [
        [{ text: '🎮 Play Game', web_app: { url: 'https://your-vercel-url.com' } }],
        [{ text: '💰 My Balance', callback_data: 'check_balance' }],
        [{ text: '📥 Deposit', callback_data: 'deposit' }],
        [{ text: '📤 Withdrawal', callback_data: 'withdrawal' }]
      ]
    }
  });
});

bot.onText(/\/balance/, async (msg) => {
  const chatId = msg.chat.id;
  const telegramId = msg.from?.id || 0;
  const username = msg.from?.username || 'Unknown';

  const userId = await ensureUser(telegramId, username, msg.from?.first_name || 'Player');
  const balance = await getUserBalance(userId);

  bot.sendMessage(chatId, `👤 *Account*\nUsername: @${username}\n\n💰 *Balance*\nCurrent: ${fmt(balance)} ETB\nPending: 0.00 ETB`, { parse_mode: 'Markdown' });
});

bot.onText(/\/deposit/, (msg) => {
  const chatId = msg.chat.id;
  bot.sendMessage(chatId, `💳 *Deposit Funds*\n\nPlease transfer the amount to our official bank account:\n\n🏦 *Bank:* Commercial Bank of Ethiopia (CBE)\n👤 *Account Name:* DASHEN BINGO PLC\n🔢 *Account Number:* 1000123456789\n\n📌 *Minimum Deposit:* 10 ETB\n\n*How to verify your deposit:*\n1. Make the transfer from your bank app.\n2. Take a screenshot of the success message/SMS.\n3. Send the screenshot or transaction ID to this chat.\n4. Our admin will verify and credit your wallet within 5 minutes!`, { parse_mode: 'Markdown' });
});

bot.onText(/\/withdrawal/, (msg) => {
  const chatId = msg.chat.id;
  bot.sendMessage(chatId, `📤 *Withdrawal*\n\nWithdrawal feature is coming soon! For now, please contact support.`, { parse_mode: 'Markdown' });
});

bot.onText(/\/addfunds/, async (msg) => {
  const chatId = msg.chat.id;
  const telegramId = msg.from?.id || 0;
  const username = msg.from?.username || 'Unknown';

  const userId = await ensureUser(telegramId, username, msg.from?.first_name || 'Player');

  await addFunds(userId, 500, 'Test funds added via /addfunds command');
  const newBalance = await getUserBalance(userId);

  bot.sendMessage(chatId, `✅ *Test Funds Added!*\n\nNew Balance: ${fmt(newBalance)} ETB`, { parse_mode: 'Markdown' });
});

bot.on('callback_query', async (query) => {
  const chatId = query.message?.chat.id;
  const data = query.data;
  const from = query.from;
  const telegramId = from.id || 0;
  const username = from.username || 'Unknown';

  if (data === 'check_balance') {
    await bot.answerCallbackQuery(query.id, { text: 'Fetching your balance...' });
    const userId = await ensureUser(telegramId, username, from.first_name || 'Player');
    const balance = await getUserBalance(userId);
    await bot.sendMessage(chatId, `👤 *Account*\nUsername: @${username}\n\n💰 *Balance*\nCurrent: ${fmt(balance)} ETB\nPending: 0.00 ETB`, { parse_mode: 'Markdown' });
  } else if (data === 'deposit') {
    await bot.answerCallbackQuery(query.id, { text: 'Opening deposit instructions...' });
    await bot.sendMessage(chatId, `💳 *Deposit Funds*\n\nPlease transfer the amount to our official bank account:\n\n🏦 *Bank:* Commercial Bank of Ethiopia (CBE)\n👤 *Account Name:* DASHEN BINGO PLC\n🔢 *Account Number:* 1000123456789\n\n📌 *Minimum Deposit:* 10 ETB\n\n*How to verify your deposit:*\n1. Make the transfer from your bank app.\n2. Take a screenshot of the success message/SMS.\n3. Send the screenshot or transaction ID to this chat.\n4. Our admin will verify and credit your wallet within 5 minutes!`, { parse_mode: 'Markdown' });
  } else if (data === 'withdrawal') {
    await bot.answerCallbackQuery(query.id, { text: 'Opening withdrawal...' });
    await bot.sendMessage(chatId, `📤 *Withdrawal*\n\nWithdrawal feature is coming soon! For now, please contact support.`, { parse_mode: 'Markdown' });
  }
});

console.log('✅ [BOT] Bot is running and connected to Neon database!');
