import express from 'express';
import http from 'http';
import { Server } from 'socket.io';
import dotenv from 'dotenv';
import { GameEngine } from './gameEngine';

dotenv.config();

const app = express();
const server = http.createServer(app);

// Initialize Socket.IO
const io = new Server(server, {
  cors: { origin: "*" }
});

const PORT = process.env.PORT || 3000;

app.get('/', (req, res) => {
  res.json({ status: 'Dashen Bingo API is running!', game: 'active' });
});

// Initialize the Game Engine (The Referee)
const gameEngine = new GameEngine(io);

io.on('connection', (socket) => {
  console.log('✅ Player connected:', socket.id);
  
  // Send current game state immediately upon connection
  socket.emit('game:sync', gameEngine.getCurrentState());

  socket.on('disconnect', () => {
    console.log('❌ Player disconnected:', socket.id);
  });
});

server.listen(PORT, () => {
  console.log(`🚀 Server is running on http://localhost:${PORT}`);
  console.log(`💡 Open this URL in your browser or Telegram Mini App to test.`);
});
